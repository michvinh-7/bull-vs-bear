# Backend URL. Leave NEXT_PUBLIC_USE_MOCK=true to build the UI before the backend is ready.
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_USE_MOCK=true

# Public address of the site, for link previews (og:image). Optional on Vercel, which supplies its production URL.
# NEXT_PUBLIC_SITE_URL=https://your-domain.example
