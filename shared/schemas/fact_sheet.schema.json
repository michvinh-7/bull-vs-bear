{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FactSheet",
  "description": "Made once per company by Person 1. Both debaters argue only from this.",
  "type": "object",
  "required": ["company", "ticker", "metrics", "debt_details", "news"],
  "properties": {
    "company": { "type": "string" },
    "ticker": { "type": "string" },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "value", "source"],
        "properties": {
          "name": { "type": "string", "description": "e.g. leverage, interest_coverage, floating_rate_pct, next_maturity_year, liquidity_usd" },
          "value": { "type": "number" },
          "source": { "type": "string", "description": "e.g. \"10-K · Note 9, p. 84\"" }
        }
      }
    },
    "debt_details": {
      "type": "array",
      "items": { "type": "object" },
      "description": "Free-form per instrument for now (name, amount, rate, maturity, secured, source). Lock down at hour 0 if needed."
    },
    "news": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["headline", "url"],
        "properties": {
          "headline": { "type": "string" },
          "url": { "type": "string" }
        }
      }
    }
  }
}
