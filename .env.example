# Copy to backend/.env and fill in. Key names only. NEVER commit real keys.

# Gemini (debaters, claim extraction, brief, news via Search grounding)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ElevenLabs (one voice per character)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_BULL=
ELEVENLABS_VOICE_BEAR=
ELEVENLABS_VOICE_MODERATOR=
VOICE_ENABLED=false

# Supabase (leave blank to use in-memory storage locally)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Hugging Face (fact-checking)
HF_API_TOKEN=

# SEC EDGAR requires a User-Agent with a contact email
SEC_USER_AGENT="BullVsBear hackathon your-email@example.com"

# CORS: the deployed frontend URL
FRONTEND_ORIGIN=http://localhost:3000

MAX_TURNS=8
